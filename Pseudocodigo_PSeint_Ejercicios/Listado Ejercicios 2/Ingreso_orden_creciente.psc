Algoritmo Ingreso_orden_creciente
	Definir a, b, c Como Entero;
	Escribir "Ingresa un número: ";
	Leer a;
	Escribir Sin Saltar "Ingresa otro número: ";
	Leer b;
	Escribir Sin Saltar"Ingresa un último número: ";
	Leer c;
	Si a < b y b < c Entonces
		Escribir "Los números fueron ingresados en orden creciente";
	SiNo
		Escribir "Los números no fueron ingresados en orden creciente";
	FinSi
FinAlgoritmo
